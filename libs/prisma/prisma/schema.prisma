generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  ACCOUNTANT
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
}

model Company {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  users     User[]
  customers Customer[]
  invoices  Invoice[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model User {
  id             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String                  @db.Uuid
  company        Company                 @relation(fields: [companyId], references: [id])
  email          String                  @unique
  name           String
  passwordHash   String
  role           UserRole
  refreshTokens  RefreshToken[]
  statusChanges  InvoiceStatusChange[]
  createdInvoices Invoice[]              @relation("InvoiceCreatedBy")
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([companyId])
}

model Customer {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String    @db.Uuid
  company   Company   @relation(fields: [companyId], references: [id])
  name      String
  email     String?
  phone     String?
  taxId     String?
  address   String?
  notes     String?
  invoices  Invoice[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([companyId])
}

model Invoice {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String              @db.Uuid
  company     Company             @relation(fields: [companyId], references: [id])
  customerId  String              @db.Uuid
  customer    Customer            @relation(fields: [customerId], references: [id])
  createdById String              @db.Uuid
  createdBy   User                @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  number      String?
  status      InvoiceStatus       @default(DRAFT)
  issueDate   DateTime?
  dueDate     DateTime
  paidAt      DateTime?
  currency    String              @default("IDR")
  subtotal    Decimal             @db.Decimal(19, 4)
  taxTotal    Decimal             @db.Decimal(19, 4)
  total       Decimal             @db.Decimal(19, 4)
  items       InvoiceItem[]
  history     InvoiceStatusChange[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, dueDate])
  @@index([companyId, createdAt])
}

model InvoiceItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId   String   @db.Uuid
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position    Int
  description String
  quantity    Decimal  @db.Decimal(12, 4)
  unitPrice   Decimal  @db.Decimal(19, 4)
  taxRate     Decimal  @db.Decimal(5, 2)
  createdAt   DateTime @default(now())

  @@index([invoiceId])
}

model InvoiceStatusChange {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId    String         @db.Uuid
  invoice      Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  fromStatus   InvoiceStatus?
  toStatus     InvoiceStatus
  changedById  String         @db.Uuid
  changedBy    User           @relation(fields: [changedById], references: [id])
  at           DateTime       @default(now())

  @@index([invoiceId])
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
