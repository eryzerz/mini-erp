# Local development (docker compose) — copy to .env
DATABASE_URL="postgresql://slm:slm@localhost:5433/slm_erp?schema=public"
DATABASE_URL_TEST="postgresql://slm:slm@localhost:5433/slm_erp_test?schema=public"
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
# Comma-separated list of allowed frontend origins (next dev bumps the port
# to 3001 when 3000 is taken — add your port if you see a CORS error).
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"
PORT=4000
